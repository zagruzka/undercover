# Secret Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-auth-secret

# Google OAuth (opsional). Jika kosong, tombol Login Google disembunyikan.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL API backend Elysia (dipanggil dari server Next.js)
BACKEND_URL=http://localhost:4000
# URL WebSocket backend (dipanggil dari browser)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Harus SAMA dengan nilai di backend/.env
INTERNAL_API_SECRET=change-me-internal-secret
WS_JWT_SECRET=change-me-ws-jwt-secret
