PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/undercover
REDIS_URL=redis://localhost:6379
# Origin frontend yang diizinkan (CORS)
FRONTEND_ORIGIN=http://localhost:3000
# Harus SAMA dengan INTERNAL_API_SECRET di frontend/.env.local
INTERNAL_API_SECRET=change-me-internal-secret
# Harus SAMA dengan WS_JWT_SECRET di frontend/.env.local
WS_JWT_SECRET=change-me-ws-jwt-secret
